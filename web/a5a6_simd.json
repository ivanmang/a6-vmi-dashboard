0d7128","arch":"A5","kernel_full":"QuantBf16toMXFp4SquareKernel","simd":467,"ipc":1.35,"ec":35.08,"delta":-10.9},{"kernel":"Square sq32","case":"128\u00d7128","arch":"A6","kernel_full":"QuantBf16toMXFp4SquareKernel","simd":416,"ipc":1.36,"ec":39.38,"delta":null}],"notes":"A6 WINS 10 of 14 comparable cases. FP8 MODE_MERGING \u22122 to \u221232% SIMD; FP4/NVFp4\n\u221218 to \u221245%; sq32 \u22128.6 to \u221210.9% (larger blocks give the 3-EXU scheduler more ILP).\nA5 keeps AbsReduceMax (+19.7% \u2014 A6's vcgmax v2 lowering splits into vcgmaxv2+\nvcmaxv2, +128 LNQ issues) and sq16 (+8.5 to +10.7%, two veccores exploit smaller\nblocks better).\nSquare S3 (MERGING+vselr+NORM_B8) is correct but 1.74\u20132.01\u00d7 slower than S0\n(PK4_B32): the 2 vselr add 128\u2013272 LNQ issues vs S0's 4\u201316 \u2014 S0 stays recommended.\nSweep: S0 U1 fastest; U2 marginal; U4/8 spill. Why A6 loses sq16: for pure ADD/MUL/CONV workloads A6's third EXU\n(LNQ) is unusable \u2014 vcvt/vmul/vadd issue on EXQ0/1 exactly like A5's two EXUs \u2014 so\nthroughput is EXU-count-equal and the deltas come from instruction count and\nscheduling. The A6 ports here still run the A5 spellings, which on A6 pay: (a) each\nconceptual vcmax becomes vcgmaxv2 (EXQ) + vcmaxv2 (LNQ) \u2014 2 instructions where A5\nhad 1, and the EXQ half steals a slot from the main arithmetic; (b) no MODE_MERGING\n(A5 can't encode it, so the ported spellings still carry the vor merges A6 could\nfold away); (c) no A6-style unroll (U=2) \u2014 the square kernel's A6 side keeps its own\ntuned STRATEGY=2/UNROLL=2 design, which is why sq32 lands at parity. Re-tuning the\nports for A6 (MERGING narrows, vcgmaxv2-horizontal absmax, U=2) is the expected fix."},"dequant":{"rows":[{"kernel":"DequantMXFp8\u2192FP32","case":"128\u00d7128","arch":"A5","kernel_full":"DequantMXFp8Kernel","simd":580,"ipc":0.93,"ec":28.25,"delta":-16.0},{"kernel":"DequantMXFp8\u2192FP32","case":"128\u00d7128","arch":"A6 opt","kernel_full":"DequantMXFp8Kernel","simd":487,"ipc":1.13,"ec":33.64,"delta":null},{"kernel":"DequantMXFp8\u2192BF16","case":"128\u00d7128","arch":"A5","kernel_full":"DequantMXFp8Kernel","simd":514,"ipc":1.52,"ec":31.88,"delta":8.0},{"kernel":"DequantMXFp8\u2192BF16","case":"128\u00d7128","arch":"A6 opt","kernel_full":"DequantMXFp8Kernel","simd":555,"ipc":1.45,"ec":29.52,"delta":null},{"kernel":"DequantHiF4\u2192BF16","case":"128\u00d7128","arch":"A6","kernel_full":"DequantHiF4Kernel","simd":269,"ipc":1.15,"ec":60.91,"delta":null},{"kernel":"DequantHiF4\u2192FP32","case":"128\u00d7128","arch":"A6","kernel_full":"DequantHiF4Kernel","simd":501,"ipc":1.13,"ec":32.7,"delta":null}],"notes":"DequantMXFp8: A6 wins 0.84\u00d7. DequantHiF4 vintlv-free opt is the largest single win (\u221233/\u221234%). A5 has no HiF4. The A5 dequant CCE twins are the\nv4 IFU-log-mirror kernels (UNPK4+P0 widens, BRC half-mask scale expansion, INTLV\nstores); the DSL twins BEAT CCE on all four A5 cases (454/550/534/688)."}}